#!/bin/sh
# Start the current wishmap release (see src/wishmap/updater.py):
#
#   wishmap-launch UPDATE_DIR [uvicorn options...]
#
# Run by the service supervisor (OpenRC's supervise-daemon) as the server's
# user, which restarts it whenever it exits, e.g. after a self-update ended
# the process. After an update (UPDATE_DIR/pending exists) the new release
# gets MAX_TRIES starts; the server removes `pending` once it is up. If it
# never comes up, `current` goes back to `previous`, and `rolled-back` names
# the release that failed, for the server to report.
set -eu

MAX_TRIES=3

dir=${1:?usage: wishmap-launch UPDATE_DIR [uvicorn options...]}
shift
cd "$dir"

if [ -e pending ]; then
	tries=$(($(cat pending 2>/dev/null || echo 0) + 1))
	if [ "$tries" -gt "$MAX_TRIES" ] && [ -L previous ]; then
		failed=$(basename "$(readlink current)")
		echo "wishmap-launch: release $failed did not start $MAX_TRIES times; rolling back" >&2
		ln -sfn "$(readlink previous)" .current.tmp
		mv -fT .current.tmp current
		echo "$failed" >rolled-back
		rm -f pending
	else
		echo "$tries" >pending
	fi
fi

exec "$dir/current/bin/uvicorn" wishmap.app:app "$@"
